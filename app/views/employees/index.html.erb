<h1>Employees</h1>

<!-- Employees Table -->
<div class="mt-3">
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>Employee ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Department</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @employees.each do |employee| %>
        <tr>
          <td><%= employee.employee_id %></td>
          <td><%= employee.name %></td>
          <td><%= employee.email %></td>
          <td><%= employee.department&.name %></td>
          <td>
            <% if employee.status == "Active" %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-danger">Inactive</span>
            <% end %>
          </td>
          <td><%= link_to "Show", employee %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><strong>Total Employees:</strong> <%= @employees.count %></p>
</div>

<!-- Managers Table -->
<h2 class="mt-5">Managers</h2>
<div class="mt-3">
  <table class="table table-bordered table-striped table-primary">
    <thead>
      <tr>
        <th>Manager ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Department</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @managers.each do |manager| %>
        <tr>
          <td><%= manager.employee_id %></td>
          <td><%= manager.name %></td>
          <td><%= manager.email %></td>
          <td><%= manager.department&.name %></td>
          <td><%= manager.status %></td>
          <td>
            <%= link_to "Show", manager %> |
            <%= link_to "View Team", team_employee_path(manager) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><strong>Total Managers:</strong> <%= @managers.count %></p>
</div>
