<h2>Team Members under <%= @manager.name %></h2>
<p>
  <strong>Manager ID:</strong> <%= @manager.employee_id %><br>
  <strong>Email:</strong> <%= @manager.email %><br>
  <strong>Department:</strong> <%= @manager.department&.name %><br>
  <strong>Status:</strong>
  <% if @manager.status == "Active" %>
    <span class="badge bg-success">Active</span>
  <% else %>
    <span class="badge bg-danger">Inactive</span>
  <% end %>
</p>

<!-- Filter Form -->
<%= form_with url: team_employee_path(@manager), method: :get, local: true do |form| %>
  <%= form.text_field :query, placeholder: "Search by name or ID", class: "form-control d-inline-block w-auto" %>

  <%= form.select :status, options_for_select(
    [["All Statuses", ""], ["Active", "Active"], ["Inactive", "Inactive"]],
    params[:status]
  ), {}, class: "form-select d-inline-block w-auto" %>

  <%= form.select :department_id, options_for_select(
    [["All Departments", ""]] + @departments.map { |d| [d.name, d.id] },
    params[:department_id]
  ), {}, class: "form-select d-inline-block w-auto" %>

  <%= form.submit "Filter", class: "btn btn-primary" %>
  <%= link_to "Clear Filters", team_employee_path(@manager), class: "btn btn-secondary" %>
<% end %>

<!-- Team Members Table -->
<div class="mt-3">
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th><%= link_to "Employee ID", team_employee_path(@manager, sort: "employee_id", direction: params[:direction] == "asc" ? "desc" : "asc", query: params[:query], status: params[:status], department_id: params[:department_id], page: params[:page]) %></th>
        <th><%= link_to "Name", team_employee_path(@manager, sort: "name", direction: params[:direction] == "asc" ? "desc" : "asc", query: params[:query], status: params[:status], department_id: params[:department_id], page: params[:page]) %></th>
        <th>Email</th>
        <th><%= link_to "Department", team_employee_path(@manager, sort: "department_id", direction: params[:direction] == "asc" ? "desc" : "asc", query: params[:query], status: params[:status], department_id: params[:department_id], page: params[:page]) %></th>
        <th><%= link_to "Status", team_employee_path(@manager, sort: "status", direction: params[:direction] == "asc" ? "desc" : "asc", query: params[:query], status: params[:status], department_id: params[:department_id], page: params[:page]) %></th>
      </tr>
    </thead>
    <tbody>
      <% @employees.each do |emp| %>
        <tr>
          <td><%= emp.employee_id %></td>
          <td><%= emp.name %></td>
          <td><%= emp.email %></td>
          <td><%= emp.department&.name %></td>
          <td>
            <% if emp.status == "Active" %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-danger">Inactive</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Pagination -->
<%= paginate @employees %>

<%= link_to "Back to Managers", employees_path(anchor: "managers"), class: "btn btn-link mt-2" %>
