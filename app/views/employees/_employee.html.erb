<div id="<%= dom_id employee %>">
  <div>
    <strong>Name:</strong>
    <%= employee.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= employee.email %>
  </div>

  <div>
    <strong>Employee:</strong>
    <%= employee.employee_id %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= employee.status %>
  </div>

  <div>
    <strong>Age:</strong>
    <%= employee.age %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= employee.department_id %>
  </div>

  <div>
    <strong>Manager:</strong>
    <%= employee.manager_id %>
  </div>

</div>
